# Copiar a .env y ajustar. Nunca versionar .env.
# development | test | production
FINORA_ENVIRONMENT=development
FINORA_DATABASE_URL=postgresql+psycopg://finora:finora@localhost:5432/finora

# Origen de finora-web (redirecciones y Origin permitido).
FINORA_WEB_URL=http://localhost:5173

# Correo: por defecto, Mailpit local (docker compose up -d mailpit; bandeja en http://localhost:8025).
FINORA_SMTP_HOST=localhost
FINORA_SMTP_PORT=1025
FINORA_SMTP_USERNAME=
FINORA_SMTP_PASSWORD=
FINORA_EMAIL_FROM=FINORA <no-responder@finora.local>

# Google (OpenID Connect). Vacías: el inicio con Google queda desactivado.
FINORA_GOOGLE_CLIENT_ID=
FINORA_GOOGLE_CLIENT_SECRET=

# Clave AES-256 para cifrar los secretos de MFA. Obligatoria fuera de development.
# Generar con: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Vacía en development: se usa una clave temporal y la MFA configurada deja de servir al reiniciar.
FINORA_MFA_ENCRYPTION_KEY=

# Versión vigente de la política de tratamiento de datos personales (0 = provisional, PA-AUTH-12).
FINORA_PRIVACY_POLICY_VERSION=0

# true solo si hay un proxy de confianza delante que fija X-Forwarded-For.
FINORA_TRUSTED_PROXY=false

# Límites por IP: intentos de inicio de sesión cada 15 minutos; registros, recuperaciones y
# reenvíos de correo cada hora.
FINORA_RATE_LIMIT_LOGIN_PER_IP=20
FINORA_RATE_LIMIT_EMAIL_PER_IP=10
